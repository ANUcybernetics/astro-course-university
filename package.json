{
  "name": "astro-course-anu",
  "version": "0.7.0",
  "description": "Companion to astro-theme-anu for ANU course sites — build-time content-graph integration (`courseGraph()`), reusable Zod schemas (`courseNodeSchema`, news, people), and a `getPublishedCollection` helper.",
  "keywords": [
    "anu",
    "astro-component",
    "astro-integration",
    "course",
    "withastro"
  ],
  "homepage": "https://gitlab.anu.edu.au/u2548636/astro-theme-anu",
  "bugs": {
    "url": "https://gitlab.anu.edu.au/u2548636/astro-theme-anu/-/issues"
  },
  "license": "MIT",
  "author": "Ben Swift <ben.swift@anu.edu.au>",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.anu.edu.au/u2548636/astro-theme-anu.git",
    "directory": "packages/astro-course-anu"
  },
  "files": [
    "CHANGELOG.md",
    "components",
    "index.ts",
    "content-helpers.ts",
    "course-content.ts",
    "course-graph.ts",
    "course-graph-integration.ts",
    "schemas.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./content": "./content-helpers.ts",
    "./schemas": "./schemas.ts",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
