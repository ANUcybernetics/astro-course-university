{
  "name": "astro-course-university",
  "version": "0.1.1",
  "description": "Brand-neutral course-site infrastructure for Astro: a content-graph integration, reusable Zod schemas, course API generation, and related-content components.",
  "keywords": [
    "astro-component",
    "astro-integration",
    "course",
    "withastro"
  ],
  "homepage": "https://github.com/ANUcybernetics/astro-course-university",
  "bugs": {
    "url": "https://github.com/ANUcybernetics/astro-course-university/issues"
  },
  "license": "MIT",
  "author": "Ben Swift <ben@benswift.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANUcybernetics/astro-course-university.git"
  },
  "files": [
    "CHANGELOG.md",
    "components",
    "index.ts",
    "content-helpers.ts",
    "course-content.ts",
    "course-graph.ts",
    "course-graph-integration.ts",
    "schemas.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./content": "./content-helpers.ts",
    "./schemas": "./schemas.ts",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint && pnpm lint:css",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "lint:css": "stylelint '**/*.css' --allow-empty-input",
    "lint:css:fix": "stylelint '**/*.css' --allow-empty-input --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.0",
    "@types/node": "^24.0.0",
    "astro": "^7.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
