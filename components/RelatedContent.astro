---
/**
 * Related-content block for any graph node's detail page: internal
 * related entries (undirected — declared, embedded, or incoming) as
 * site links, then external `links:` frontmatter entries. Renders
 * nothing when the node has neither.
 *
 * Assumes the site's URL convention `/<collection>/<slug>/`, i.e. that
 * each graph collection's detail route lives at its collection name —
 * the same convention that makes refs, node ids, and API paths agree.
 */
import { getRelatedEntries } from "../content-helpers.js";
import type { GraphEntry } from "../content-helpers.js";

interface Props {
  entry: GraphEntry & { data: { links?: { label: string; url: string }[] } };
  /** Every graph-participating collection key, as passed to courseGraph(). */
  collections: string[];
  heading?: string;
}

const { entry, collections, heading = "Related" } = Astro.props;
const related = await getRelatedEntries(entry, collections);
const links = entry.data.links ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{
  (related.length > 0 || links.length > 0) && (
    <aside class="related-content" aria-label={heading}>
      <h2>{heading}</h2>
      <ul>
        {related.map((e) => (
          <li>
            <a href={`${base}/${e.collection}/${e.id}/`}>{e.data.title}</a>
          </li>
        ))}
        {links.map((l) => (
          <li class="external">
            <a href={l.url}>{l.label}</a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .related-content {
    margin-block-start: 3rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .related-content h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-content ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .related-content .external a::after {
    content: " \2197";
  }
</style>
