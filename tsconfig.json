{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "astro/client"]
  },
  "include": ["**/*.ts", "**/*.astro"],
  "exclude": ["node_modules", "dist"]
}
